# =============================================================================
# NEXA TC — environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development (`cp .env.example .env.local`).
# Never commit `.env.local` or any file containing real secrets.
# Values marked (optional) may be omitted until you enable that integration.
# =============================================================================

# -----------------------------------------------------------------------------
# App config
# -----------------------------------------------------------------------------
# Canonical URL of this deployment — used in emails, redirects, and absolute links.
# Local: http://localhost:3000  ·  Prod: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Social OAuth buttons — comma-separated UI keys sent to Supabase Auth `signInWithOAuth`:
# google, azure (Microsoft), apple, facebook, linkedin_oidc (LinkedIn OIDC).
# Leave empty to hide OAuth buttons locally until Dashboard providers + redirect URLs are configured.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Local UAT only — skips Supabase MFA gate for tc/admin in middleware (never enable in production).
# scripts/run-local-uat.sh sets this automatically.
NEXA_SKIP_MFA=

# Safety gate for scripts/seed.ts — must be 1 to allow UAT data/user seeding.
# Keep empty by default so accidental runs fail closed.
ALLOW_UAT_SEED=

# Secondary guard: seed.ts refuses NODE_ENV=production unless this is explicitly set to 1.
# Keep empty in all normal environments.
ALLOW_UAT_SEED_IN_PROD=

# -----------------------------------------------------------------------------
# Supabase (database, auth, storage, realtime)
# -----------------------------------------------------------------------------
# Project URL — Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Anonymous (public) key — safe for browser; Dashboard → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only; Dashboard → API → service_role (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for attachments / inbound pipeline — create bucket in Dashboard → Storage
SUPABASE_ATTACHMENTS_BUCKET=attachments

# -----------------------------------------------------------------------------
# Encryption (tenant integration credentials at rest)
# -----------------------------------------------------------------------------
# 32-byte AES key, base64-encoded — generate: openssl rand -base64 32
# Used to encrypt rows in api_integrations.credentials_json
API_INTEGRATIONS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# JWT secrets (invites)
# -----------------------------------------------------------------------------
# Long random string for signing invite tokens — generate: openssl rand -hex 32
INVITE_JWT_SECRET=

# -----------------------------------------------------------------------------
# Anthropic (AI First Pass / document extraction)
# -----------------------------------------------------------------------------
# Console → API Keys → create key
ANTHROPIC_API_KEY=

# Model id override — default in code if unset (e.g. claude-3-5-haiku-20241022)
ANTHROPIC_MODEL=

# -----------------------------------------------------------------------------
# DocuSign (JWT Grant eSignature REST API)
# -----------------------------------------------------------------------------
# Apps and Keys → Integration — Integration Key (GUID)
DOCUSIGN_INTEGRATION_KEY=

# User GUID — Apps and Keys → My Account → User ID for impersonation
DOCUSIGN_USER_ID=

# API Account ID — Apps and Keys → select app → Account ID
DOCUSIGN_ACCOUNT_ID=

# RSA private key PEM for JWT — paste full PEM, or base64 of PEM (see lib/docusign/client.ts)
DOCUSIGN_RSA_PRIVATE_KEY=

# OAuth hostname — developer account: account-d.docusign.com · prod often account.docusign.com
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com

# REST API base URL — demo: https://demo.docusign.net/restapi · prod region-specific
DOCUSIGN_REST_BASE_PATH=https://demo.docusign.net/restapi

# Connect webhook HMAC — DocuSign Connect → secret key for signature verification
DOCUSIGN_WEBHOOK_HMAC_SECRET=

# Fallback name if DOCUSIGN_WEBHOOK_HMAC_SECRET unset (same purpose)
WEBHOOK_SECRET_DOCUSIGN=

# Tenant UUID to associate inbound Connect events when envelope omits tenant mapping
DOCUSIGN_WEBHOOK_DEFAULT_TENANT_ID=

# Which document slot to pull when webhook completes (often "1")
DOCUSIGN_WEBHOOK_DOCUMENT_ID=1

# -----------------------------------------------------------------------------
# Postmark (transactional email + inbound)
# -----------------------------------------------------------------------------
# Server API token — Sender signatures → API Tokens
POSTMARK_SERVER_TOKEN=

# From address — must be verified sender/domain in Postmark
EMAIL_FROM=

# Inbound routing Basic Auth — Postmark Inbound → webhook credentials you configure
POSTMARK_INBOUND_BASIC_USER=
POSTMARK_INBOUND_BASIC_PASS=

# Default tenant UUID when inbound email cannot infer tenant from routing rules
POSTMARK_INBOUND_DEFAULT_TENANT_ID=

# -----------------------------------------------------------------------------
# Upstash Redis (rate limits: API + login; invite token store)
# -----------------------------------------------------------------------------
# REST URL — Upstash console → database → REST API → UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_URL=

# REST token — same screen
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# ATTOM Data / property enrichment (also overridable per tenant via api_integrations)
# -----------------------------------------------------------------------------
# ATTOM product API key — ATTOM developer portal
ATTOM_API_KEY=

# Base URL for property endpoints — product docs / account dashboard
ATTOM_API_BASE_URL=

# -----------------------------------------------------------------------------
# MLS — RESO Web API (OAuth 2.0; tenant store may override)
# -----------------------------------------------------------------------------
# OData / RESO resource URL prefix (Bridge / Spark / vendor-specific RESO URL)
MLS_API_BASE_URL=

# OAuth token endpoint URL from your MLS vendor docs
MLS_TOKEN_URL=

# OAuth client id / secret from MLS vendor developer portal
MLS_CLIENT_ID=
MLS_CLIENT_SECRET=

# Space-separated scopes — vendor docs (often api.apirole.rdd.coreresource)
MLS_SCOPE=

# -----------------------------------------------------------------------------
# Plaid (bank / financial linking — lib/bank/client.ts)
# -----------------------------------------------------------------------------
# Dashboard → Team Settings → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox | development | production
PLAID_ENV=sandbox

# -----------------------------------------------------------------------------
# Bank integration (legacy env fallbacks — prefer Plaid + tenant credentials)
# -----------------------------------------------------------------------------
BANK_API_BASE_URL=
BANK_API_KEY=
BANK_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Inngest (background jobs / AI First Pass workflow)
# -----------------------------------------------------------------------------
# Inngest Cloud → app → Keys — Event Key (sending events from app if needed)
INNGEST_EVENT_KEY=

# Signing key — verifies requests to /api/inngest in production
INNGEST_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Email fallbacks (optional — primary path is Postmark above)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Webhooks (misc)
# -----------------------------------------------------------------------------
# Reserved for non–Basic-Auth email webhook verification if extended
WEBHOOK_SECRET_EMAIL=

# -----------------------------------------------------------------------------
# Cron / internal jobs (optional)
# -----------------------------------------------------------------------------
CRON_SECRET=
