# App
NEXT_PUBLIC_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypt api_integrations.credentials_json at rest (base64-encoded **32-byte** key)
API_INTEGRATIONS_ENCRYPTION_KEY=

# Attachments bucket for Postmark inbound (create in Supabase Dashboard → Storage)
SUPABASE_ATTACHMENTS_BUCKET=attachments

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# DocuSign (JWT Grant — PEM or base64-encoded PEM in DOCUSIGN_RSA_PRIVATE_KEY)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_RSA_PRIVATE_KEY=
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com
DOCUSIGN_REST_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_WEBHOOK_HMAC_SECRET=
DOCUSIGN_WEBHOOK_DEFAULT_TENANT_ID=
DOCUSIGN_WEBHOOK_DOCUMENT_ID=1

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Upstash (Redis + rate limit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MLS (RESO Web API — OAuth; tenant-specific URLs/tokens may override via api_integrations)
MLS_API_BASE_URL=
MLS_TOKEN_URL=
MLS_CLIENT_ID=
MLS_CLIENT_SECRET=
MLS_SCOPE=

# ATTOM property API (also configurable per tenant in api_integrations / provider `attom`)
ATTOM_API_KEY=
ATTOM_API_BASE_URL=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Bank integration (legacy placeholders — prefer Plaid env above)
BANK_API_BASE_URL=
BANK_API_KEY=
BANK_WEBHOOK_SECRET=

# Email (transactional + Postmark inbound)
EMAIL_FROM=
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_BASIC_USER=
POSTMARK_INBOUND_BASIC_PASS=
POSTMARK_INBOUND_DEFAULT_TENANT_ID=

RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Incoming webhooks (signature verification)
WEBHOOK_SECRET_DOCUSIGN=
WEBHOOK_SECRET_EMAIL=

# Invites (signed JWT, 72h)
INVITE_JWT_SECRET=

# Misc
CRON_SECRET=
