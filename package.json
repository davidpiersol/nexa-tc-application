    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docusign-esign": "^8.0.1",
    "framer-motion": "^11.18.2",
    "fuse.js": "^7.1.0",
    "inngest": "^3.31.7",
    "jose": "^5.10.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "next": "^14.2.21",
