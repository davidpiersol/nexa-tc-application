{
  "name": "nexa-tc-application",
  "version": "4.32.3-dev",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "bash scripts/dev-fresh.sh",
    "dev:clean": "bash scripts/dev-fresh.sh",
    "verify:with-clean-dev": "bash scripts/verify-with-clean-dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "bash scripts/smoke-http.sh",
    "integration:ten": "bash scripts/integration-ten-step.sh",
    "help:build": "node scripts/compile-help.mjs",
    "env:init": "bash scripts/init-env-local.sh",
    "prebuild": "npm run help:build",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ready": "bash scripts/full-local-ready.sh",
    "seed:uat": "ALLOW_UAT_SEED=1 tsx --env-file=.env.local scripts/seed.ts",
    "uat:api": "tsx --env-file=.env.local scripts/uat.ts",
    "uat": "bash scripts/run-local-uat.sh",
    "playwright:install": "playwright install chromium",
    "smoke:local": "PLAYWRIGHT_AUTO_SERVER=1 PLAYWRIGHT_BASE_URL=http://localhost:3100 playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
